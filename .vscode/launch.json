                "-k", "5",
                "-drop",   "0.2",

                "-npatches", "4",
                "-n_annotated_patches", "1",
                "-pages_train", "1",

                "-e", "200",
                "-b", "16",
                "-verbose", "1",

                "-res", "results/res.txt", 
                "-gpu", "0", 
                //"-no_mask",
